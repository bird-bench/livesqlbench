ARG POSTGRES_BASE_IMAGE=postgres:14.12
FROM ${POSTGRES_BASE_IMAGE}

# Set PostgreSQL credentials
ENV POSTGRES_USER=root
ENV POSTGRES_PASSWORD=123123
ENV PGDATA=/var/lib/postgresql/livesqlbench-data

# Copy scripts and build-time seed assets
COPY environment/init-db.sh /usr/local/bin/livesqlbench-init-db.sh
COPY environment/bootstrap-db-image.sh /usr/local/bin/livesqlbench-bootstrap-db-image.sh
COPY environment/db-entrypoint.sh /usr/local/bin/livesqlbench-db-entrypoint.sh
COPY db_seed /opt/livesqlbench/db_seed

RUN chmod +x /usr/local/bin/livesqlbench-init-db.sh \
    /usr/local/bin/livesqlbench-bootstrap-db-image.sh \
    /usr/local/bin/livesqlbench-db-entrypoint.sh \
    && mkdir -p "${PGDATA}" /docker-entrypoint-initdb.d/db_assets \
    && touch /opt/livesqlbench/db_seed/preprocess.sql \
    && chown -R postgres:postgres /usr/local/bin/livesqlbench-init-db.sh \
        /usr/local/bin/livesqlbench-bootstrap-db-image.sh \
        /usr/local/bin/livesqlbench-db-entrypoint.sh \
        /opt/livesqlbench \
        /docker-entrypoint-initdb.d \
        /var/lib/postgresql \
    && gosu postgres /usr/local/bin/livesqlbench-bootstrap-db-image.sh

USER postgres
ENTRYPOINT ["/usr/local/bin/livesqlbench-db-entrypoint.sh"]
CMD ["postgres"]

# Health check: verify PostgreSQL is running
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=30 \
    CMD pg_isready -U ${POSTGRES_USER} || exit 1
